 void MergeDigestEngine::RegisterMergeSlots(
     const std::vector<MergeSlot>& slots) {
-  pinned_slots_ = slots;
+  pinned_slots_.clear();
+  owned_refs_.clear();
+  pinned_slots_.reserve(slots.size());
+  owned_refs_.reserve(slots.size());
+
+  for (const MergeSlot& slot : slots) {
+    if (!slot.pinned || slot.ref_ptr == nullptr || slot.ref_len == 0) {
+      pinned_slots_.push_back(slot);
+      continue;
+    }
+
+    owned_refs_.emplace_back(slot.ref_ptr, slot.ref_ptr + slot.ref_len);
+    MergeSlot owned = slot;
+    owned.ref_ptr = owned_refs_.back().data();
+    pinned_slots_.push_back(owned);
+  }
 }
 
