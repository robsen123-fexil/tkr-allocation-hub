@@ -39,7 +39,23 @@ bool ValidateSlotBounds(const DeferredSlot& slot) {
 
 void BatchDigestEngine::RegisterDeferredSlots(
     const std::vector<DeferredSlot>& slots) {
-  active_slots_ = slots;
+  active_slots_.clear();
+  owned_payloads_.clear();
+  active_slots_.reserve(slots.size());
+  owned_payloads_.reserve(slots.size());
+
+  for (const DeferredSlot& slot : slots) {
+    if (!slot.active || slot.payload_ptr == nullptr || slot.payload_len == 0) {
+      active_slots_.push_back(slot);
+      continue;
+    }
+
+    owned_payloads_.emplace_back(slot.payload_ptr,
+                                 slot.payload_ptr + slot.payload_len);
+    DeferredSlot owned = slot;
+    owned.payload_ptr = owned_payloads_.back().data();
+    active_slots_.push_back(owned);
+  }
 }
 
